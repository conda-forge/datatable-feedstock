From: conda-forge
Subject: [PATCH] Fix tests for numpy 2

`np.NaN` was removed in numpy 2.0, and `repr()` of a NaT scalar changed;
compare the values with `np.isnat()` instead.

--- a/tests/ijby/test-sort.py
+++ b/tests/ijby/test-sort.py
@@ -1021,7 +1021,7 @@
     {
     'A': ['o1','o2','o3','o4','o5'],
     'B': ['c1','c1','c2','c2','c3'],
-    'C': [5, 1, 3, numpy.NaN, numpy.NaN]
+    'C': [5, 1, 3, numpy.nan, numpy.nan]
     })
     EXP = DT[:, :, dt.sort(f.B, -f.A)]
     RES1 = DT[:, :, dt.sort("B", "A", reverse=[False, True])]
@@ -1037,7 +1037,7 @@
     {
     'A': ['o1', 'o2', 'o3', 'o4', 'o5'],
     'B': ['c1', 'c1', 'c2', 'c2', 'c3'],
-    'C': [5,1,3, numpy.NaN,numpy.NaN]
+    'C': [5,1,3, numpy.nan,numpy.nan]
     })
     EXP = DT[:, :, dt.sort(-f.A, -f.B)]
     RES1 = DT[:, :, dt.sort("B", "A", reverse=[True, True])]
@@ -1055,7 +1055,7 @@
     {
     'A': ['o1', 'o2', 'o3', 'o4', 'o5']*25,
     'B': ['c1', 'c1', 'c2', 'c2', 'c3']*25,
-    'C': [5, 1, 3, numpy.NaN, numpy.NaN]*25
+    'C': [5, 1, 3, numpy.nan, numpy.nan]*25
     })
     with pytest.raises(ValueError, match=msg):
         DT[:, :, dt.sort(0, 1, reverse=[True])]
--- a/tests/types/test-time64.py
+++ b/tests/types/test-time64.py
@@ -317,9 +317,9 @@
     assert arr.dtype == np.dtype('datetime64[ns]')
     assert arr[0, 0] == np.datetime64('1901-12-13T00:11:59.000000000')
     assert arr[1, 0] == np.datetime64('2001-02-17T00:30:00.000000000')
-    assert repr(arr[2, 0]) == repr(np.datetime64('NaT'))
+    assert np.isnat(arr[2, 0])
     assert arr[3, 0] == np.datetime64('2077-05-17T23:59:01.002345000')
-    assert repr(arr[4, 0]) == repr(np.datetime64('NaT'))
+    assert np.isnat(arr[4, 0])
     assert arr[5, 0] == np.datetime64('1911-11-11T11:11:11.000011000')
 
 
